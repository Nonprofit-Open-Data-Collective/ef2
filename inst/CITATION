citHeader("To cite the ef2 package in publications, use:")

## `meta` is supplied by citation(); guard for direct sourcing.
if (!exists("meta") || is.null(meta)) meta <- utils::packageDescription("ef2")
ver <- meta$Version
if (is.null(ver) || is.na(ver)) ver <- "0.1.0"

bibentry(
  bibtype  = "Manual",
  title    = "ef2: Tools for Building and Maintaining the IRS 990 Efiler Database",
  author   = person(
    given   = "Jesse",
    family  = "Lecy",
    comment = c(ORCID = "0000-0003-4974-0782")
  ),
  year     = "2025",
  note     = paste("R package version", ver),
  url      = "https://github.com/Nonprofit-Open-Data-Collective/ef2"
)
